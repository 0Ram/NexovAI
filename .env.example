# ==========================================
# Nexov Health Voice AI - Environment Configuration
# ==========================================

# Google Gemini API Key (Recommended for LLM function calling & reasoning)
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ElevenLabs API Key (Required for Realtime STT and TTS synthesis)
# Get an API key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: ElevenLabs Custom Voice ID (Default: 'Rachel' 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Server Port Configuration
PORT=8000
HOST=0.0.0.0
